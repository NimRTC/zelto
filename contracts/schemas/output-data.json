{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Output Data",
  "description": "Schema for structured data output",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "description": "The structured data payload"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Total count when data is paginated or filtered"
    },
    "showing": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of items currently shown"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    }
  },
  "additionalProperties": false
}
