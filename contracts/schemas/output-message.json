{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Output Message",
  "description": "Schema for plain text output messages",
  "type": "object",
  "required": ["message"],
  "properties": {
    "message": {
      "type": "string",
      "description": "The output message text"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the output"
    }
  },
  "additionalProperties": false
}
