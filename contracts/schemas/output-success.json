{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Output Success",
  "description": "Schema for success output",
  "type": "object",
  "required": ["success", "message"],
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Always true for success messages"
    },
    "message": {
      "type": "string",
      "description": "Success message text"
    },
    "data": {
      "description": "Optional data payload accompanying the success"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    }
  },
  "additionalProperties": false
}
