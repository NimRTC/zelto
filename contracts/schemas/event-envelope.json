{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event Envelope",
  "description": "Unified event envelope for all zelto events",
  "type": "object",
  "required": ["ts", "runSeq", "slice", "type", "actor", "payload"],
  "properties": {
    "ts": { "type": "string", "format": "date-time", "description": "ISO 8601 timestamp" },
    "runSeq": { "type": "integer", "minimum": 1, "description": "Per-run monotonic sequence number" },
    "slice": { "type": "string", "description": "Slice identifier" },
    "run": { "type": ["string", "null"], "description": "Run identifier" },
    "type": {
      "type": "string",
      "description": "Event type. The enum here is the source of truth; src/core/events/stream.ts (EVENT_TYPES) and src/core/audit/trail.ts must stay in sync with it.",
      "enum": [
        "slice.state.changed", "slice.baseline_registered", "slice.drift_detected", "slice.hotfix",
        "project.policy_migrated",
        "spec.drafted", "spec.checked", "spec.frozen",
        "clarify.question", "clarify.answer",
        "run.started", "run.resumed", "run.stalled", "run.finished", "run.aborted",
        "policy.decision", "policy.anchor_mismatch", "policy.violation",
        "reservation.acquired", "reservation.released",
        "gate.executed", "gate.result", "gate.retry",
        "stall.classified",
        "question.raised",
        "question.answered",
        "budget.spent", "llm.called",
        "queue.enqueued", "queue.dequeued",
        "sign.requested", "sign.approved", "sign.rejected", "sign.revoked",
        "batch.halted",
        "merge.completed",
        "merge.planned",
        "merge.phase_complete",
        "merge.conflict",
        "merge.stale_base",
        "sched.admitted", "sched.blocked",
        "worktree.created", "worktree.removed",
        "coord.dep_added",
        "coord.phase_ready",
        "coord.phase_complete",
        "coord.cycle_detected",
        "artifact.conflict_detected",
        "version.accepted",
        "version.delivered",
        "draft.created",
        "draft.revised",
        "draft.confirmed",
        "contract.evolution_checked",
        "contract.baseline_updated",
        "version.regression_recorded",
        "version.regression_detected"
      ]
    },
    "actor": { "type": "string", "description": "Actor that produced this event (hook, cli, system, user)" },
    "payload": { "type": "object", "description": "Event-specific payload" }
  }
}
