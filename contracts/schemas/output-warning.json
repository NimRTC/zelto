{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Output Warning",
  "description": "Schema for warning output",
  "type": "object",
  "required": ["warning"],
  "properties": {
    "warning": {
      "type": "string",
      "description": "Warning message text"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    }
  },
  "additionalProperties": false
}
