{
  "name": "zelto",
  "version": "0.5.0",
  "description": "AI Programming Cockpit — let machines watch the machines",
  "license": "MIT",
  "author": "Runshine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NimRTC/zelto.git"
  },
  "type": "module",
  "bin": {
    "zelto": "./dist/cli/index.js",
    "zelto-hook": "./dist/hook/index.js"
  },
  "scripts": {
    "build": "tsc",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:credentials": "node scripts/scan-credentials.mjs",
    "dev": "tsc --watch",
    "test": "node scripts/check-encoding.mjs && tsc -p tsconfig.test.json && node --test \"dist-test/tests/**/*.test.js\"",
    "test:quick": "node --test \"dist-test/tests/**/*.test.js\"",
    "test:unit": "tsc -p tsconfig.test.json && node scripts/filter-tests.mjs",
    "test:acceptance": "node --test \"dist-test/tests/acceptance/**/*.test.js\"",
    "test:watch": "node --test --watch",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "clean": "rm -rf dist dist-test",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "private": true,
  "files": [
    "dist/",
    "contracts/",
    "policy/",
    "bin/",
    "misc/",
    "syntax/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "biome": "^0.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.306",
    "@clack/prompts": "^1.8.1",
    "js-yaml": "^5.5.0"
  }
}
